{
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@server/*": [
        "./src/server/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@client/*": [
        "./src/client/*"
      ]
    }
  },
  "references": [
    {
      "path": "./tsconfig.vite.json"
    },
    {
      "path": "./tsconfig.server.json"
    },
    {
      "path": "./tsconfig.client.json"
    }
  ]
}