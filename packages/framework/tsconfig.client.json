{
    "compilerOptions": {
        "composite": true,
        "jsx": "react-jsx",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "esnext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "types": [
            "vite/client"
        ],
        "paths": {
            "@shared/*": [
                "./src/shared/*"
            ],
            "@client/*": [
                "./src/client/*"
            ]
        }
    },
    "include": [
        "./src/client/**/*",
        "./src/shared/**/*",
    ]
}