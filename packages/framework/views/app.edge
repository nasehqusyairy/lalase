<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8" />
    <title>
        {{ title }}
    </title>
    {{{ viteHead }}}
</head>

<body>
    <div id="root" data-page='{{ JSON.stringify({ component, props }) }}'>{{{ appHtml }}}</div>

    @if(process.env.APP_ENV === 'production')
    @else
        <script type="module" src="/src/client/entry-client.tsx"></script>
    @end
</body>

</html>
