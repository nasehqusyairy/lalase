{
    "compilerOptions": {
        "composite": true,
        "sourceMap": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "target": "esnext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "paths": {
            "@server/*": [
                "./src/server/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ]
        },
        "outDir": "./dist",
        "rootDir": "./src"
    },
    "include": [
        "./src/server/**/*",
        "./src/shared/**/*",
        "./src/server.ts"
    ]
}