{
  "name": "@lalase/framework",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx --env-file=.env server.ts",
    "build": "npm run build:client && npm run build:ssr && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build --ssr src/client/entry-server.tsx --outDir dist/ssr",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@inertiajs/react": "^3.1.1",
    "@lalase/oerem": "workspace:*",
    "babel-plugin-react-compiler": "^1.0.0",
    "express": "^5.2.1",
    "express-edge": "^3.0.0",
    "express-session": "^1.19.0",
    "knex": "^3.2.9",
    "multer": "^2.0.2",
    "mysql2": "^3.22.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite-plugin-babel": "^1.4.1"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@inertiajs/vite": "^3.1.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.1.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "esbuild": "0.27.4",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0",
    "vite": "^7.2.4"
  }
}