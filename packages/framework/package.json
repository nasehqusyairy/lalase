{
  "name": "@lalase/framework",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec tsx --env-file=.env server.ts",
    "build": "npm run build:client && npm run build:ssr && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:ssr": "vite build --ssr src/client/entry-server.tsx --outDir dist/ssr",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "node --env-file=.env dist/index.js"
  },
  "dependencies": {
    "@chantouchsek/validatorjs": "^2.2.7",
    "@lalase/oerem": "workspace:*",
    "axios": "^1.13.4",
    "code-excerpt": "^4.0.0",
    "edge.js": "^6.5.0",
    "express": "^5.2.1",
    "express-edge": "^3.0.0",
    "express-session": "^1.19.0",
    "knex": "^3.2.9",
    "multer": "^2.0.2",
    "mysql": "^2.18.1",
    "mysql2": "^3.22.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.2.4",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.18.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.1.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "autoprefixer": "^10",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "0.27.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "nodemon": "^3.1.11",
    "postcss": "^8",
    "react-compiler-runtime": "^1.0.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-babel": "^1.4.1",
    "vite-plugin-inspect": "^11.3.3",
    "vite-tsconfig-paths": "^6.0.5"
  }
}